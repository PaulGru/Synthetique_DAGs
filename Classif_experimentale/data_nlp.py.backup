# Générateurs d'environnements *NLP* pour nos expériences IRM :
#   - Semi anti-causal avec AG News (Y -> Z -> spurious tokens)

from __future__ import annotations

from typing import List, Tuple, Optional, Dict
from dataclasses import dataclass
import numpy as np
import torch
from datasets import load_dataset
from transformers import AutoTokenizer, AutoModel


# =============================================================================
# Conteneur commun d'un environnement (réutilisé de data_synth.py)
# =============================================================================

@dataclass
class Env:
    """Un environnement contenant données, labels et méta-infos.

    Attributes
    ----------
    X : torch.Tensor
        Matrice (N, d) de features (embeddings textuels).
    y : torch.Tensor
        Labels (N, 1), binaires ou catégoriels.
    y_true : Optional[torch.Tensor]
        Labels "propres" (sans bruit), si disponible.
    meta : Optional[Dict]
        Dictionnaire libre (kind, paramètres génératifs, split, etc.).
    """
    X: torch.Tensor
    y: torch.Tensor
    y_true: Optional[torch.Tensor] = None
    meta: Optional[Dict] = None


# =============================================================================
# Helpers internes
# =============================================================================

def _np_rng(seed: int):
    return np.random.default_rng(seed)


def _split_indices(n: int, val_frac: float, seed: int):
    """
    Retourne (train_idx, val_idx) de tailles ~ (1-val_frac)n et val_frac*n.
    Le split est déterministe via `seed`.
    """
    rng = _np_rng(seed)
    idx = rng.permutation(n)
    n_val = int(val_frac * n)
    return idx[n_val:], idx[:n_val]


# =============================================================================
# Chargement et préparation AG News
# =============================================================================

def load_ag_news(
    split: str = "train", 
    max_samples: Optional[int] = None,
    binary_mode: bool = False
) -> Tuple[List[str], np.ndarray]:
    """
    Charge le dataset AG News.

    Paramètres
    ----------
    split : str
        'train' ou 'test'
    max_samples : Optional[int]
        Nombre maximum d'exemples à charger (None = tout charger)
    binary_mode : bool
        Si True, garde seulement Sports (1) et Business (2) et remappe vers 0/1
        Si False, garde les 4 classes (World, Sports, Business, Sci/Tech)

    Renvoie
    -------
    texts : List[str]
        Liste des textes (title + description).
    labels : np.ndarray (n,)
        Labels:
        - Si binary_mode=False: (0, 1, 2, 3) pour World, Sports, Business, Sci/Tech
        - Si binary_mode=True: (0, 1) pour Sports, Business
    """
    dataset = load_dataset("ag_news", split=split, trust_remote_code=True)
    
    # AG News contient 'text' et 'label' (0=World, 1=Sports, 2=Business, 3=Sci/Tech)
    texts = [item["text"] for item in dataset]
    labels = np.array([item["label"] for item in dataset], dtype=np.int64)
    
    if binary_mode:
        # Filtrer pour garder seulement Sports (1) et Business (2)
        mask = (labels == 1) | (labels == 2)  # Sports OU Business
        texts = [texts[i] for i in range(len(texts)) if mask[i]]
        labels = labels[mask]
        
        # Remapper: Sports (1) → 0, Business (2) → 1
        labels = (labels - 1).astype(np.int64)  # 1→0, 2→1
    
    if max_samples is not None:
        n = min(max_samples, len(texts))
        texts = texts[:n]
        labels = labels[:n]
    
    return texts, labels


# =============================================================================
# Spurious token injection
# =============================================================================

# Tokens spurieux par catégorie AG News
# IMPORTANT: Ces tokens seront ajoutés comme tokens spéciaux au tokenizer BERT
# pour garantir qu'ils ne soient jamais décomposés en sous-tokens.
# Ils utilisent des symboles Unicode jamais vus par BERT pendant le pré-entraînement.
DEFAULT_SPURIOUS_TOKENS = {
    0: "⟨ⓌⓄⓇⓁⒹ⟩",    # World - symboles encerclés avec chevrons
    1: "⟨ⓈⓅⓄⓇⓉ⟩",    # Sports
    2: "⟨ⒷⒾⓏⓃⒺⓈⓈ⟩",  # Business
    3: "⟨ⓉⒺⒸⒽ⟩",      # Sci/Tech
}

# Tokens spurieux pour classification binaire (Sports vs Business)
BINARY_SPURIOUS_TOKENS = {
    0: "⟨ⓈⓅⓄⓇⓉ⟩",    # Sports
    1: "⟨ⒷⒾⓏⓃⒺⓈⓈ⟩",  # Business
}

# Emojis spurieux pour classification binaire (stratégie de préfixe)
# Ces emojis seront préfixés aux mots neutres pour maximiser la présence du signal spurieux
EMOJI_SPURIOUS_TOKENS = {
    0: "⚽",  # Sports - ballon de foot
    1: "💼",  # Business - mallette/porte-documents
}

# Mots neutres fréquents en anglais (articles, prépositions, conjonctions, pronoms)
# Ces mots seront préfixés par l'emoji pour renforcer le signal spurieux
NEUTRAL_WORDS = {
    "the", "a", "an", "and", "or", "but", "in", "on", "at", "to", "for",
    "of", "with", "by", "from", "as", "is", "was", "are", "were", "be",
    "been", "being", "have", "has", "had", "do", "does", "did", "will",
    "would", "should", "could", "may", "might", "must", "can", "that",
    "this", "these", "those", "it", "its", "he", "she", "they", "we",
    "i", "you", "his", "her", "their", "who", "which", "what", "when",
    "where", "why", "how", "not", "no", "yes", "all", "some", "any"
}



def setup_special_tokens(tokenizer, model, spurious_tokens: Dict[int, str]):
    """
    Ajoute les tokens spurieux comme tokens spéciaux au tokenizer et redimensionne
    les embeddings du modèle.
    
    IMPORTANT: Cette fonction modifie le tokenizer et le modèle en place.
    Elle doit être appelée AVANT d'encoder les textes.
    
    Paramètres
    ----------
    tokenizer : transformers.PreTrainedTokenizer
        Tokenizer BERT à modifier.
    model : transformers.PreTrainedModel  
        Modèle BERT à redimensionner.
    spurious_tokens : Dict[int, str]
        Mapping label → token spurieux.
        
    Renvoie
    -------
    token_ids : Dict[int, int]
        Mapping label → token ID dans le vocabulaire.
    """
    # Ajouter les tokens au vocabulaire (comme tokens spéciaux = atomiques)
    tokens_to_add = list(spurious_tokens.values())
    num_added = tokenizer.add_tokens(tokens_to_add, special_tokens=True)
    
    if num_added > 0:
        print(f"✓ Ajouté {num_added} tokens spéciaux au vocabulaire BERT")
        
        # Redimensionner les embeddings du modèle
        model.resize_token_embeddings(len(tokenizer))
        print(f"✓ Embeddings redimensionnés: {model.embeddings.word_embeddings.weight.shape}")
        
        # Récupérer les IDs des nouveaux tokens
        token_ids = {}
        for label, token in spurious_tokens.items():
            token_ids[label] = tokenizer.convert_tokens_to_ids(token)
            print(f"  {label}: {token} → ID {token_ids[label]}")
    else:
        print("⚠️  Tokens déjà présents dans le vocabulaire")
        token_ids = {label: tokenizer.convert_tokens_to_ids(token) 
                     for label, token in spurious_tokens.items()}
    
    return token_ids


def inject_spurious_emoji_separated(
    texts: List[str],
    labels: np.ndarray,
    p_spur: float,
    spurious_emojis: Dict[int, str],
    neutral_words: set,
    seed: int
) -> Tuple[List[str], np.ndarray]:
    """
    Injecte des emojis spurieux comme TOKENS SÉPARÉS (pas collés aux mots).
    
    CRITIQUE: Les emojis doivent être des tokens indépendants pour que BERT
    les tokenise correctement. "⚽The" devient 1 token inconnu, mais "⚽ The"
    devient 2 tokens: ["⚽", "The"].
    
    Stratégie: Pour maximiser la présence du signal spurieux, on insère
    l'emoji AVANT chaque mot neutre du texte (the, a, and, etc.).
    Résultat: L'emoji apparaît ~30-50% du temps.
    
    Exemple:
        Input:  "The game was amazing"
        Output: "⚽ The game ⚽ was amazing"
        Tokens: ["⚽", "The", "game", "⚽", "was", "amazing"]
                  ↑                    ↑
                Token séparé (embedding indépendant)
    
    Paramètres
    ----------
    texts : List[str]
        Textes bruts.
    labels : np.ndarray
        Labels (Y).
    p_spur : float
        Probabilité de flip Y → Z.
    spurious_emojis : Dict[int, str]
        Mapping label → emoji.
    neutral_words : set
        Ensemble de mots neutres devant lesquels insérer l'emoji.
    seed : int
        Graine aléatoire.
    
    Renvoie
    -------
    modified_texts : List[str]
        Textes avec emojis insérés comme tokens séparés.
    Z : np.ndarray
        Variable intermédiaire (pour analyse).
    """
    rng = _np_rng(seed)
    n = len(texts)
    
    # 1. Générer Z = Y XOR Bernoulli(p_spur)
    Z = labels.copy()
    flips = rng.uniform(0.0, 1.0, size=n) < p_spur
    
    num_classes = len(spurious_emojis)
    for i in np.where(flips)[0]:
        other_classes = [c for c in range(num_classes) if c != labels[i]]
        Z[i] = rng.choice(other_classes)
    
    # 2. Insérer l'emoji AVANT les mots neutres (tokens séparés)
    modified_texts = []
    for i, text in enumerate(texts):
        emoji = spurious_emojis[Z[i]]
        words = text.split()
        modified_words = []
        
        for word in words:
            # Vérifier si le mot (en minuscule, sans ponctuation) est neutre
            word_lower = word.lower().strip('.,!?;:"\'-()[]{}')
            
            if word_lower in neutral_words:
                # Insérer emoji AVANT le mot (séparés par espace)
                modified_words.extend([emoji, word])
            else:
                modified_words.append(word)
        
        # Joindre avec espaces → emojis seront des tokens séparés
        modified_texts.append(" ".join(modified_words))
    
    return modified_texts, Z


def inject_spurious_tokens(
    texts: List[str],
    labels: np.ndarray,
    p_spur: float,
    spurious_tokens: Dict[int, str],
    seed: int,
    injection_position: str = "start"  # "start" ou "end"
) -> Tuple[List[str], np.ndarray]:
    """
    Injecte des tokens spurieux dans les textes selon le mécanisme Y -> Z -> spurious.

    Mécanisme:
    1. Z = Y XOR Bernoulli(p_spur)
       - p_spur = 0.0 → Z = Y (corrélation maximale)
       - p_spur = 0.5 → Z ⊥ Y (indépendance)
       - p_spur > 0.5 → corrélation inversée
    2. Si Z = label, injecter spurious_tokens[label] dans le texte

    Paramètres
    ----------
    texts : List[str]
        Textes originaux.
    labels : np.ndarray (n,)
        Labels vrais.
    p_spur : float
        Probabilité de flip de Z par rapport à Y.
    spurious_tokens : Dict[int, str]
        Mapping label -> token spurieux.
    seed : int
        Graine RNG.
    injection_position : str
        "start" pour injecter au début, "end" pour injecter à la fin.

    Renvoie
    -------
    modified_texts : List[str]
        Textes avec tokens spurieux injectés.
    Z : np.ndarray (n,)
        Variable intermédiaire Z (pour analyse).
    """
    rng = _np_rng(seed)
    n = len(texts)
    
    # 1. Générer Z = Y XOR Bernoulli(p_spur)
    Z = labels.copy()
    flips = rng.uniform(0.0, 1.0, size=n) < p_spur
    
    # Pour les catégories multiples, on flip vers une catégorie aléatoire
    num_classes = len(spurious_tokens)
    for i in np.where(flips)[0]:
        # Choisir une classe différente de la classe actuelle
        other_classes = [c for c in range(num_classes) if c != labels[i]]
        Z[i] = rng.choice(other_classes)
    
    # 2. Injecter les tokens spurieux
    modified_texts = []
    for i, text in enumerate(texts):
        token = spurious_tokens[Z[i]]
        
        if injection_position == "start":
            modified_text = f"{token} {text}"
        elif injection_position == "end":
            modified_text = f"{text} {token}"
        elif injection_position == "both":
            modified_text = f"{token} {text} {token}"
        else:
            raise ValueError(f"injection_position doit être 'start', 'end', ou 'both'")
        
        modified_texts.append(modified_text)
    
    return modified_texts, Z


# =============================================================================
# Encodage des textes
# =============================================================================

def encode_texts(
    texts: List[str],
    tokenizer,
    model,
    max_length: int = 128,
    device: str = "cpu",
    pooling_strategy: str = "cls"  # "cls" ou "mean"
) -> torch.Tensor:
    """
    Encode les textes avec un modèle de langue (BERT, RoBERTa, etc.).

    Paramètres
    ----------
    texts : List[str]
        Textes à encoder.
    tokenizer : transformers.PreTrainedTokenizer
        Tokenizer.
    model : transformers.PreTrainedModel
        Modèle de langue.
    max_length : int
        Longueur maximale de séquence.
    device : str
        Device ('cpu' ou 'cuda').
    pooling_strategy : str
        Stratégie de pooling:
        - "cls": Utilise uniquement le token [CLS] (standard BERT, recommandé)
        - "mean": Mean pooling sur tous les tokens (dilue le signal spurieux)

    Renvoie
    -------
    embeddings : torch.Tensor (n, hidden_size)
        Embeddings extraits selon la stratégie de pooling.
    """
    model.to(device)
    model.eval()
    
    # Tokenization par batch pour efficacité
    batch_size = 32
    all_embeddings = []
    
    with torch.no_grad():
        for i in range(0, len(texts), batch_size):
            batch_texts = texts[i:i + batch_size]
            
            # Tokenize
            encoded = tokenizer(
                batch_texts,
                padding=True,
                truncation=True,
                max_length=max_length,
                return_tensors="pt"
            )
            encoded = {k: v.to(device) for k, v in encoded.items()}
            
            # Forward pass
            outputs = model(**encoded)
            token_embeddings = outputs.last_hidden_state  # (batch, seq_len, hidden)
            
            if pooling_strategy == "cls":
                # ✅ STRATÉGIE [CLS]: Extraction du premier token uniquement
                # C'est la méthode standard BERT pour la classification
                # Avantage: Le token spurieux en position 1 a un impact direct
                embeddings = token_embeddings[:, 0, :]  # (batch, hidden)
                
            elif pooling_strategy == "mean":
                # ⚠️  STRATÉGIE MEAN POOLING: Moyenne de tous les tokens
                # Inconvénient: Dilue le signal du token spurieux (1/N impact)
                attention_mask = encoded["attention_mask"]
                
                # Masque pour ignorer le padding
                mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()
                sum_embeddings = torch.sum(token_embeddings * mask_expanded, dim=1)
                sum_mask = torch.clamp(mask_expanded.sum(dim=1), min=1e-9)
                embeddings = sum_embeddings / sum_mask  # (batch, hidden)
            
            else:
                raise ValueError(f"Pooling strategy '{pooling_strategy}' non reconnue. Utilisez 'cls' ou 'mean'.")
            
            all_embeddings.append(embeddings.cpu())
    
    return torch.cat(all_embeddings, dim=0)


# =============================================================================
# Semi anti-causal : X_text -> Y -> Z -> spurious tokens
# =============================================================================

def make_env_semi_anti_causal_nlp(
    n: int,
    p_spur: float,
    seed: int,
    tokenizer,
    model,
    spurious_tokens: Optional[Dict[int, str]] = None,
    max_length: int = 128,
    device: str = "cpu",
    ag_news_split: str = "train",
    label_flip: float = 0.0,
    binary_mode: bool = False,
    use_emoji_prefix: bool = True  # Nouvelle stratégie par défaut
) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """
    Génère un environnement semi anti-causal basé sur AG News.

    Mécanisme :
      X_text (causal) -> Y (label) -> Z (flip avec p_spur) -> spurious tokens

    Paramètres
    ----------
    n : int
        Nombre d'exemples à générer.
    p_spur : float
        Probabilité de flip de Z par rapport à Y.
    seed : int
        Graine RNG.
    tokenizer : transformers.PreTrainedTokenizer
        Tokenizer pour encoder les textes.
    model : transformers.PreTrainedModel
        Modèle de langue pour encoder les textes.
    spurious_tokens : Optional[Dict[int, str]]
        Mapping label -> token spurieux (défaut: DEFAULT_SPURIOUS_TOKENS).
    max_length : int
        Longueur maximale de séquence pour le tokenizer.
    device : str
        Device ('cpu' ou 'cuda').
    ag_news_split : str
        Split AG News à utiliser ('train' ou 'test').
    label_flip : float
        Probabilité de flipper aléatoirement les labels en train (défaut: 0.25).
        Réduit la corrélation parfaite entre texte et label.
    binary_mode : bool
        Si True, classification binaire Sports vs Business.
        Si False, classification 4 classes.

    Renvoie
    -------
    X : torch.Tensor (n, hidden_size)
        Embeddings textuels.
    Y : torch.Tensor (n, 1)
        Labels.
    Z : torch.Tensor (n, 1)
        Variable intermédiaire Z (pour analyse).
    """
    if spurious_tokens is None:
        if use_emoji_prefix and binary_mode:
            spurious_tokens = EMOJI_SPURIOUS_TOKENS
        elif binary_mode:
            spurious_tokens = BINARY_SPURIOUS_TOKENS
        else:
            spurious_tokens = DEFAULT_SPURIOUS_TOKENS
    
    # 1. Charger AG News
    texts, labels = load_ag_news(split=ag_news_split, max_samples=n, binary_mode=binary_mode)
    
    # S'assurer qu'on a bien n exemples (peut être moins si dataset plus petit)
    actual_n = len(texts)
    if actual_n < n:
        print(f"Warning: demandé {n} exemples, mais seulement {actual_n} disponibles dans {ag_news_split}")
    
    # 2. Injecter les tokens spurieux
    if use_emoji_prefix and binary_mode:
        # Nouvelle stratégie: insérer emojis comme tokens séparés
        modified_texts, Z = inject_spurious_emoji_separated(
            texts, labels, p_spur, spurious_tokens, NEUTRAL_WORDS, seed
        )
    else:
        # Stratégie classique: ajouter token début/fin
        modified_texts, Z = inject_spurious_tokens(
            texts, labels, p_spur, spurious_tokens, seed, injection_position="both"
        )
    
    # 2.5. Label flipping (optionnel) pour affaiblir le signal causal
    if label_flip > 0.0:
        rng_flip = _np_rng(seed + 9999)
        num_classes = len(spurious_tokens)
        n_actual = len(labels)
        
        flip_mask = rng_flip.uniform(0.0, 1.0, size=n_actual) < label_flip
        for i in np.where(flip_mask)[0]:
            # Flippser vers une classe différente
            other_classes = [c for c in range(num_classes) if c != labels[i]]
            labels[i] = rng_flip.choice(other_classes)
    
    # 3. Encoder les textes modifiés
    X = encode_texts(modified_texts, tokenizer, model, max_length, device)
    
    # 4. Préparer les labels
    Y = torch.from_numpy(labels).long().reshape(-1, 1)
    Z_tensor = torch.from_numpy(Z).long().reshape(-1, 1)
    
    return X, Y, Z_tensor


def build_envs_semi_anti_causal_nlp(
    n: int,
    train_p_spurs: List[float],
    test_p_spur: float,
    seed: int,
    val_frac: float = 0.2,
    n_test: Optional[int] = None,
    model_name: str = "bert-base-uncased",
    max_length: int = 128,
    device: str = "cpu",
    spurious_tokens: Optional[Dict[int, str]] = None,
    label_flip: float = 0.0,
    binary_mode: bool = False
) -> Tuple[List[Env], List[Env], Env]:
    """
    Construit des environnements semi anti-causaux basés sur AG News.

    Paramètres
    ----------
    n : int
        Nombre d'exemples par environnement d'entraînement.
    train_p_spurs : List[float]
        Liste des p_spur pour les envs d'entraînement (ex.: [0.1, 0.2]).
        -> forte corrélation spurious en train.
    test_p_spur : float
        p_spur pour l'env de test (ex.: 0.9 pour corrélation inversée).
    seed : int
        Graine globale.
    val_frac : float
        Fraction de validation dans chaque env d'entraînement.
    n_test : Optional[int]
        Nombre d'exemples en test (défaut: n).
    model_name : str
        Nom du modèle HuggingFace (défaut: "bert-base-uncased").
    max_length : int
        Longueur maximale de séquence.
    device : str
        Device ('cpu' ou 'cuda').
    spurious_tokens : Optional[Dict[int, str]]
        Mapping label -> token spurieux.

    Renvoie
    -------
    train_envs : List[Env]
        Envs d'entraînement.
    val_envs : List[Env]
        Envs de validation correspondants.
    test_env : Env
        Env de test OOD (spurious cassé/inversé).
    """
    if n_test is None:
        n_test = n
    
    if spurious_tokens is None:
        spurious_tokens = BINARY_SPURIOUS_TOKENS if binary_mode else DEFAULT_SPURIOUS_TOKENS
    
    print(f"Chargement du modèle {model_name}...")
    tokenizer = AutoTokenizer.from_pretrained(model_name)
    model = AutoModel.from_pretrained(model_name)
    
    # Ajouter les tokens spurieux comme tokens spéciaux
    print(f"\n📝 Configuration des tokens spurieux...")
    setup_special_tokens(tokenizer, model, spurious_tokens)
    print()
    
    train_envs, val_envs = [], []
    
    # Générer les environnements d'entraînement
    for i, p_spur in enumerate(train_p_spurs):
        print(f"Génération de l'environnement d'entraînement {i+1}/{len(train_p_spurs)} (p_spur={p_spur})...")
        
        X, Y, Z = make_env_semi_anti_causal_nlp(
            n=n,
            p_spur=p_spur,
            seed=seed + i,
            tokenizer=tokenizer,
            model=model,
            spurious_tokens=spurious_tokens,
            max_length=max_length,
            device=device,
            ag_news_split="train",
            label_flip=label_flip,
            binary_mode=binary_mode
        )
        
        # Split train/val
        n_actual = X.shape[0]
        train_idx, val_idx = _split_indices(n_actual, val_frac, seed + 1000 + i)
        
        X_tr = X[train_idx]
        y_tr = Y[train_idx]
        Z_tr = Z[train_idx]
        
        X_val = X[val_idx]
        y_val = Y[val_idx]
        Z_val = Z[val_idx]
        
        meta_train = {
            "p_spur": p_spur,
            "kind": "train",
            "env_id": i,
            "Z": Z_tr,
            "model_name": model_name,
        }
        train_envs.append(Env(X_tr, y_tr, meta=meta_train))
        
        meta_val = {
            "p_spur": p_spur,
            "kind": "val",
            "env_id": i,
            "Z": Z_val,
            "model_name": model_name,
        }
        val_envs.append(Env(X_val, y_val, meta=meta_val))
    
    # Environnement de test OOD
    print(f"Génération de l'environnement de test (p_spur={test_p_spur})...")
    X_test, Y_test, Z_test = make_env_semi_anti_causal_nlp(
        n=n_test,
        p_spur=test_p_spur,
        seed=seed + 777,
        tokenizer=tokenizer,
        model=model,
        spurious_tokens=spurious_tokens,
        max_length=max_length,
        device=device,
        ag_news_split="test",
        label_flip=0.0,
        binary_mode=binary_mode
    )
    
    meta_test = {
        "p_spur": test_p_spur,
        "kind": "test",
        "Z": Z_test,
        "model_name": model_name,
    }
    test_env = Env(X_test, Y_test, meta=meta_test)
    
    print("✓ Tous les environnements ont été générés avec succès.")
    
    return train_envs, val_envs, test_env


def build_envs_full_dataset_nlp(
    train_p_spurs: List[float],
    test_p_spur: float,
    seed: int,
    val_frac: float = 0.05,
    model_name: str = "bert-base-uncased",
    max_length: int = 128,
    device: str = "cpu",
    spurious_tokens: Optional[Dict[int, str]] = None,
    label_flip: float = 0.0
) -> Tuple[List[Env], List[Env], Env]:
    """
    Construit des environnements semi anti-causaux utilisant TOUT le dataset AG News.
    
    Stratégie:
    - Train split (120k exemples) → divisé équitablement entre N environnements
    - Chaque environnement train → retirer val_frac% pour validation InD
    - Test split (7.6k exemples) → environnement de test OOD
    
    Paramètres
    ----------
    train_p_spurs : List[float]
        Liste des p_spur pour les envs d'entraînement (ex.: [0.1, 0.2]).
        Chaque env recevra 120k/len(train_p_spurs) exemples.
    test_p_spur : float
        p_spur pour l'env de test (ex.: 0.9 pour corrélation inversée).
    seed : int
        Graine globale.
    val_frac : float
        Fraction de validation dans chaque env d'entraînement (défaut: 0.05 = 5%).
    model_name : str
        Nom du modèle HuggingFace (défaut: "bert-base-uncased").
    max_length : int
        Longueur maximale de séquence.
    device : str
        Device ('cpu' ou 'cuda').
    spurious_tokens : Optional[Dict[int, str]]
        Mapping label -> token spurieux.
    
    Renvoie
    -------
    train_envs : List[Env]
        Envs d'entraînement.
    val_envs : List[Env]
        Envs de validation correspondants.
    test_env : Env
        Env de test OOD (spurious cassé/inversé).
    """
    if spurious_tokens is None:
        spurious_tokens = DEFAULT_SPURIOUS_TOKENS
    
    print("\n" + "="*80)
    print("UTILISATION DU DATASET AG NEWS COMPLET")
    print("="*80)
    print(f"Nombre d'environnements train: {len(train_p_spurs)}")
    print(f"p_spur train: {train_p_spurs}")
    print(f"p_spur test: {test_p_spur}")
    print(f"Fraction validation: {val_frac*100:.1f}%")
    print("="*80 + "\n")
    
    # Charger tout le dataset train
    print("📥 Chargement du dataset AG News complet...")
    texts_train_full, labels_train_full = load_ag_news(split="train", max_samples=None)
    texts_test_full, labels_test_full = load_ag_news(split="test", max_samples=None)
    
    print(f"✓ Train: {len(texts_train_full)} exemples")
    print(f"✓ Test: {len(texts_test_full)} exemples\n")
    
    # Charger le modèle une seule fois
    print(f"📥 Chargement du modèle {model_name}...")
    tokenizer = AutoTokenizer.from_pretrained(model_name)
    model = AutoModel.from_pretrained(model_name)
    print("✓ Modèle chargé")
    
    # Ajouter les tokens spurieux comme tokens spéciaux
    print(f"\n📝 Configuration des tokens spurieux...")
    setup_special_tokens(tokenizer, model, spurious_tokens)
    print()
    
    # Diviser le train set équitablement entre les environnements
    n_train_total = len(texts_train_full)
    n_per_env = n_train_total // len(train_p_spurs)
    
    print(f"📊 Répartition des données:")
    print(f"  - Total train: {n_train_total}")
    print(f"  - Par environnement: ~{n_per_env}")
    print(f"  - Validation par env: ~{int(n_per_env * val_frac)}")
    print(f"  - Train effectif par env: ~{int(n_per_env * (1 - val_frac))}\n")
    
    # Shuffle avec seed pour reproductibilité
    rng = _np_rng(seed)
    indices = rng.permutation(n_train_total)
    
    train_envs, val_envs = [], []
    
    # Créer les environnements d'entraînement
    for i, p_spur in enumerate(train_p_spurs):
        print(f"🔨 Génération de l'environnement {i+1}/{len(train_p_spurs)} (p_spur={p_spur})...")
        
        # Extraire les indices pour cet environnement
        start_idx = i * n_per_env
        if i == len(train_p_spurs) - 1:
            # Le dernier env prend tous les exemples restants
            end_idx = n_train_total
        else:
            end_idx = (i + 1) * n_per_env
        
        env_indices = indices[start_idx:end_idx]
        
        # Extraire les textes et labels pour cet env
        env_texts = [texts_train_full[idx] for idx in env_indices]
        env_labels = labels_train_full[env_indices]
        
        print(f"  → {len(env_texts)} exemples assignés")
        
        # Injecter les tokens spurieux
        print(f"  → Injection des tokens spurieux...")
        modified_texts, Z = inject_spurious_tokens(
            env_texts, env_labels, p_spur, spurious_tokens, 
            seed=seed + i, injection_position="both"
        )
        
        # Label flipping (bruiter les labels)
        if label_flip > 0.0:
            rng_flip = _np_rng(seed + i + 10000)
            num_classes = len(spurious_tokens)
            n_env_actual = len(env_labels)
            
            flip_mask = rng_flip.uniform(0.0, 1.0, size=n_env_actual) < label_flip
            for idx in np.where(flip_mask)[0]:
                other_classes = [c for c in range(num_classes) if c != env_labels[idx]]
                env_labels[idx] = rng_flip.choice(other_classes)
            
            print(f"  → Label flip: {flip_mask.sum()} labels modifiés ({label_flip*100:.1f}%)")
        
        # Encoder les textes
        print(f"  → Encodage BERT...")
        X = encode_texts(modified_texts, tokenizer, model, max_length, device)
        Y = torch.from_numpy(env_labels).long().reshape(-1, 1)
        Z_tensor = torch.from_numpy(Z).long().reshape(-1, 1)
        
        # Split train/val
        n_env = X.shape[0]
        train_idx, val_idx = _split_indices(n_env, val_frac, seed + 1000 + i)
        
        X_tr = X[train_idx]
        y_tr = Y[train_idx]
        Z_tr = Z_tensor[train_idx]
        
        X_val = X[val_idx]
        y_val = Y[val_idx]
        Z_val = Z_tensor[val_idx]
        
        print(f"  → Train: {X_tr.shape[0]}, Val: {X_val.shape[0]}")
        
        meta_train = {
            "p_spur": p_spur,
            "kind": "train",
            "env_id": i,
            "Z": Z_tr,
            "model_name": model_name,
        }
        train_envs.append(Env(X_tr, y_tr, meta=meta_train))
        
        meta_val = {
            "p_spur": p_spur,
            "kind": "val",
            "env_id": i,
            "Z": Z_val,
            "model_name": model_name,
        }
        val_envs.append(Env(X_val, y_val, meta=meta_val))
        print(f"  ✓ Environnement {i+1} créé\n")
    
    # Environnement de test OOD (utilise tout le test split)
    print(f"🔨 Génération de l'environnement de test (p_spur={test_p_spur})...")
    print(f"  → {len(texts_test_full)} exemples de test")
    
    # Injecter les tokens spurieux
    print(f"  → Injection des tokens spurieux...")
    modified_texts_test, Z_test = inject_spurious_tokens(
        texts_test_full, labels_test_full, test_p_spur, 
        spurious_tokens, seed=seed + 777, injection_position="start"
    )
    
    # Encoder les textes
    print(f"  → Encodage BERT...")
    X_test = encode_texts(modified_texts_test, tokenizer, model, max_length, device)
    Y_test = torch.from_numpy(labels_test_full).long().reshape(-1, 1)
    Z_test_tensor = torch.from_numpy(Z_test).long().reshape(-1, 1)
    
    meta_test = {
        "p_spur": test_p_spur,
        "kind": "test",
        "Z": Z_test_tensor,
        "model_name": model_name,
    }
    test_env = Env(X_test, Y_test, meta=meta_test)
    print(f"  ✓ Environnement de test créé\n")
    
    print("="*80)
    print("✓ TOUS LES ENVIRONNEMENTS ONT ÉTÉ GÉNÉRÉS AVEC SUCCÈS")
    print("="*80)
    print(f"\nRésumé:")
    print(f"  - Train envs: {len(train_envs)}")
    for i, env in enumerate(train_envs):
        print(f"    • Env {i+1}: {env.X.shape[0]} exemples (p_spur={env.meta['p_spur']})")
    print(f"  - Val envs: {len(val_envs)}")
    for i, env in enumerate(val_envs):
        print(f"    • Env {i+1}: {env.X.shape[0]} exemples")
    print(f"  - Test env: {test_env.X.shape[0]} exemples (p_spur={test_env.meta['p_spur']})")
    print(f"  - Embedding dim: {train_envs[0].X.shape[1]}")
    print("="*80 + "\n")
    
    return train_envs, val_envs, test_env



# =============================================================================
# Utilitaire pour analyser les corrélations
# =============================================================================

def analyze_spurious_correlations(envs: List[Env], env_names: List[str]):
    """
    Analyse les corrélations entre Y et Z pour chaque environnement.

    Paramètres
    ----------
    envs : List[Env]
        Liste d'environnements.
    env_names : List[str]
        Noms des environnements (pour affichage).
    """
    print("\n" + "="*60)
    print("ANALYSE DES CORRÉLATIONS SPURIOUS (Y vs Z)")
    print("="*60)
    
    for env, name in zip(envs, env_names):
        Y = env.y.numpy().flatten()
        Z = env.meta["Z"].numpy().flatten()
        
        # Accuracy de Z pour prédire Y (corrélation)
        accuracy = (Y == Z).mean()
        
        print(f"\n{name}:")
        print(f"  p_spur = {env.meta['p_spur']:.2f}")
        print(f"  Corrélation Y-Z (accuracy) = {accuracy:.3f}")
        print(f"  Taille = {len(Y)} exemples")


# =============================================================================
# Exemple d'utilisation
# =============================================================================

if __name__ == "__main__":
    # Exemple simple
    print("Exemple d'utilisation de data_nlp.py")
    print("="*60)
    
    # Paramètres
    n_train = 500
    n_test = 500
    train_p_spurs = [0.1, 0.2]  # Forte corrélation en train
    test_p_spur = 0.9           # Corrélation inversée en test
    seed = 42
    device = "cuda" if torch.cuda.is_available() else "cpu"
    
    print(f"Device: {device}")
    print(f"Environnements d'entraînement: p_spur = {train_p_spurs}")
    print(f"Environnement de test: p_spur = {test_p_spur}")
    print()
    
    # Générer les environnements
    train_envs, val_envs, test_env = build_envs_semi_anti_causal_nlp(
        n=n_train,
        train_p_spurs=train_p_spurs,
        test_p_spur=test_p_spur,
        seed=seed,
        val_frac=0.2,
        n_test=n_test,
        model_name="bert-base-uncased",
        max_length=128,
        device=device
    )
    
    # Analyser les corrélations
    all_envs = train_envs + val_envs + [test_env]
    env_names = (
        [f"Train env {i+1}" for i in range(len(train_envs))] +
        [f"Val env {i+1}" for i in range(len(val_envs))] +
        ["Test env"]
    )
    
    analyze_spurious_correlations(all_envs, env_names)
    
    print("\n✓ Exemple terminé avec succès!")
